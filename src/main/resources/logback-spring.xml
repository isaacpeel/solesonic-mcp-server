<configuration>
    <!--
    Two streams with two jobs, the same as solesonic-llm-api.

    The application log is ECS JSON, configured by `logging.structured.*` and `logging.file.name` in
    application-prod*.properties, through Boot's structured appenders (base.xml would ignore
    logging.structured.format.*). solesonic-log-agent reads it; files written before this switch were plain text
    and it reads those too.

    The security log is plain text with a fixed grammar, parsed by fail2ban. Its format is an API, not a log
    message: treat a change to the pattern below the way you would treat a change to an endpoint contract.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="prod,prod-nginx">
        <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
        <include resource="org/springframework/boot/logging/logback/structured-file-appender.xml"/>

        <!--
        additivity=false so a security event is exactly one line in exactly one file and a jail can never
        double-count.
        -->
        <appender name="SECURITY" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/solesonic-mcp-server/security.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>/var/log/solesonic-mcp-server/security-%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="security.audit" level="INFO" additivity="false">
            <appender-ref ref="SECURITY"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %logger{10} %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
